{
  "description": "Comic Relief post-event SMS survey",
  "states": [
    {
      "name": "Trigger",
      "type": "trigger",
      "transitions": [
        {
          "event": "incomingRequest",
          "next": "Q1_Send"
        },
        {
          "event": "incomingMessage",
          "next": "Lookup_Contact"
        }
      ],
      "properties": {
        "offset": {
          "x": 0,
          "y": 150
        }
      }
    },
    {
      "name": "Lookup_Contact",
      "type": "make-http-request",
      "transitions": [
        {
          "event": "success",
          "next": "Q1_Send"
        },
        {
          "event": "failed",
          "next": "Q1_Send"
        }
      ],
      "properties": {
        "offset": {
          "x": 0,
          "y": 300
        },
        "url": "https://REPLACE_WITH_DEPLOYED_DOMAIN.twil.io/resolve-trigger-context",
        "method": "POST",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "phone",
            "value": "{{trigger.message.From}}"
          }
        ]
      }
    },
    {
      "name": "Q1_Send",
      "type": "send-and-wait-for-reply",
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "Q1_Save"
        }
      ],
      "properties": {
        "offset": {
          "x": 0,
          "y": 450
        },
        "body": "Hi {{trigger.parameters.name | default: widgets.Lookup_Contact.parsed.name}}! We're trying to learn whether events like these are a helpful tool to get people involved in their community, and would like to ask you 3-5 quick questions. We'd appreciate it if you could take the time to answer. We won't text you again once the survey is complete. You can also text STOP at any time to opt out.\n\nHow likely are you to discuss the work being done by an organization present at this event with people in your life? Reply 1 for Very Likely .... 5 for Very Unlikely",
        "timeout": "86400",
        "from": "{{flow.channel.address}}"
      }
    },
    {
      "name": "Q1_Save",
      "type": "make-http-request",
      "transitions": [
        {
          "event": "success",
          "next": "Q2_Send"
        },
        {
          "event": "failed",
          "next": "Q2_Send"
        }
      ],
      "properties": {
        "offset": {
          "x": 0,
          "y": 600
        },
        "url": "https://REPLACE_WITH_DEPLOYED_DOMAIN.twil.io/save-response",
        "method": "POST",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "respondent_id",
            "value": "{{trigger.parameters.respondent_id | default: widgets.Lookup_Contact.parsed.respondent_id}}"
          },
          {
            "key": "phone",
            "value": "{{trigger.parameters.phone | default: trigger.message.From}}"
          },
          {
            "key": "event",
            "value": "{{trigger.parameters.event | default: widgets.Lookup_Contact.parsed.event}}"
          },
          {
            "key": "q1",
            "value": "{{widgets.Q1_Send.inbound.Body}}"
          }
        ]
      }
    },
    {
      "name": "Q2_Send",
      "type": "send-and-wait-for-reply",
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "Q2_Save"
        }
      ],
      "properties": {
        "offset": {
          "x": 1200,
          "y": 750
        },
        "body": "How likely are you to volunteer with or donate to an organization that was present at this event in the next three months? Reply 1 for Very Likely .... 5 for Very Unlikely",
        "timeout": "86400",
        "from": "{{flow.channel.address}}"
      }
    },
    {
      "name": "Q2_Save",
      "type": "make-http-request",
      "transitions": [
        {
          "event": "success",
          "next": "Q3_Send"
        },
        {
          "event": "failed",
          "next": "Q3_Send"
        }
      ],
      "properties": {
        "offset": {
          "x": 1200,
          "y": 900
        },
        "url": "https://REPLACE_WITH_DEPLOYED_DOMAIN.twil.io/save-response",
        "method": "POST",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "respondent_id",
            "value": "{{trigger.parameters.respondent_id | default: widgets.Lookup_Contact.parsed.respondent_id}}"
          },
          {
            "key": "phone",
            "value": "{{trigger.parameters.phone | default: trigger.message.From}}"
          },
          {
            "key": "event",
            "value": "{{trigger.parameters.event | default: widgets.Lookup_Contact.parsed.event}}"
          },
          {
            "key": "q2",
            "value": "{{widgets.Q2_Send.inbound.Body}}"
          }
        ]
      }
    },
    {
      "name": "Q3_Send",
      "type": "send-and-wait-for-reply",
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "Q3_Save"
        }
      ],
      "properties": {
        "offset": {
          "x": 2400,
          "y": 1050
        },
        "body": "How likely are you to have a followup conversation with someone that you met at this event? Reply 1 for Very Likely .... 5 for Very Unlikely",
        "timeout": "86400",
        "from": "{{flow.channel.address}}"
      }
    },
    {
      "name": "Q3_Save",
      "type": "make-http-request",
      "transitions": [
        {
          "event": "success",
          "next": "Split_Q3Gate"
        },
        {
          "event": "failed",
          "next": "Split_Q3Gate"
        }
      ],
      "properties": {
        "offset": {
          "x": 2400,
          "y": 1200
        },
        "url": "https://REPLACE_WITH_DEPLOYED_DOMAIN.twil.io/save-response",
        "method": "POST",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "respondent_id",
            "value": "{{trigger.parameters.respondent_id | default: widgets.Lookup_Contact.parsed.respondent_id}}"
          },
          {
            "key": "phone",
            "value": "{{trigger.parameters.phone | default: trigger.message.From}}"
          },
          {
            "key": "event",
            "value": "{{trigger.parameters.event | default: widgets.Lookup_Contact.parsed.event}}"
          },
          {
            "key": "q3",
            "value": "{{widgets.Q3_Send.inbound.Body}}"
          }
        ]
      }
    },
    {
      "name": "Split_Q3Gate",
      "type": "split-based-on",
      "transitions": [
        {
          "event": "noMatch",
          "next": "Q5_Send"
        },
        {
          "event": "match",
          "next": "Q4_Send",
          "conditions": [
            {
              "friendly_name": "If value starts with 1 or 2",
              "type": "regex",
              "value": "{{widgets.Q3_Save.parsed.q3}}",
              "arguments": [
                "^\\s*[12](\\D|$)"
              ]
            }
          ]
        }
      ],
      "properties": {
        "offset": {
          "x": 2400,
          "y": 1350
        },
        "input": "{{widgets.Q3_Save.parsed.q3}}"
      }
    },
    {
      "name": "Q4_Send",
      "type": "send-and-wait-for-reply",
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "Q4_Save"
        }
      ],
      "properties": {
        "offset": {
          "x": 3600,
          "y": 1500
        },
        "body": "How likely would you have been to meet or get to know this person if not for today's event? Reply 1 for Very Likely .... 5 for Very Unlikely",
        "timeout": "86400",
        "from": "{{flow.channel.address}}"
      }
    },
    {
      "name": "Q4_Save",
      "type": "make-http-request",
      "transitions": [
        {
          "event": "success",
          "next": "Q5_Send"
        },
        {
          "event": "failed",
          "next": "Q5_Send"
        }
      ],
      "properties": {
        "offset": {
          "x": 3600,
          "y": 1650
        },
        "url": "https://REPLACE_WITH_DEPLOYED_DOMAIN.twil.io/save-response",
        "method": "POST",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "respondent_id",
            "value": "{{trigger.parameters.respondent_id | default: widgets.Lookup_Contact.parsed.respondent_id}}"
          },
          {
            "key": "phone",
            "value": "{{trigger.parameters.phone | default: trigger.message.From}}"
          },
          {
            "key": "event",
            "value": "{{trigger.parameters.event | default: widgets.Lookup_Contact.parsed.event}}"
          },
          {
            "key": "q4",
            "value": "{{widgets.Q4_Send.inbound.Body}}"
          }
        ]
      }
    },
    {
      "name": "Q5_Send",
      "type": "send-and-wait-for-reply",
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "Q5_Save"
        }
      ],
      "properties": {
        "offset": {
          "x": 6000,
          "y": 1800
        },
        "body": "When you tell others about this event, what moment are you most likely to share? (Feel free to describe it in your own words.)",
        "timeout": "86400",
        "from": "{{flow.channel.address}}"
      }
    },
    {
      "name": "Q5_Save",
      "type": "make-http-request",
      "transitions": [
        {
          "event": "success",
          "next": "Closing_Save"
        },
        {
          "event": "failed",
          "next": "Closing_Save"
        }
      ],
      "properties": {
        "offset": {
          "x": 6000,
          "y": 1950
        },
        "url": "https://REPLACE_WITH_DEPLOYED_DOMAIN.twil.io/save-response",
        "method": "POST",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "respondent_id",
            "value": "{{trigger.parameters.respondent_id | default: widgets.Lookup_Contact.parsed.respondent_id}}"
          },
          {
            "key": "phone",
            "value": "{{trigger.parameters.phone | default: trigger.message.From}}"
          },
          {
            "key": "event",
            "value": "{{trigger.parameters.event | default: widgets.Lookup_Contact.parsed.event}}"
          },
          {
            "key": "q5",
            "value": "{{widgets.Q5_Send.inbound.Body}}"
          }
        ]
      }
    },
    {
      "name": "Closing_Save",
      "type": "make-http-request",
      "transitions": [
        {
          "event": "success",
          "next": "Closing_Message"
        },
        {
          "event": "failed",
          "next": "Closing_Message"
        }
      ],
      "properties": {
        "offset": {
          "x": 7200,
          "y": 2100
        },
        "url": "https://REPLACE_WITH_DEPLOYED_DOMAIN.twil.io/save-response",
        "method": "POST",
        "content_type": "application/x-www-form-urlencoded",
        "parameters": [
          {
            "key": "respondent_id",
            "value": "{{trigger.parameters.respondent_id | default: widgets.Lookup_Contact.parsed.respondent_id}}"
          },
          {
            "key": "phone",
            "value": "{{trigger.parameters.phone | default: trigger.message.From}}"
          },
          {
            "key": "event",
            "value": "{{trigger.parameters.event | default: widgets.Lookup_Contact.parsed.event}}"
          },
          {
            "key": "completed",
            "value": "true"
          }
        ]
      }
    },
    {
      "name": "Closing_Message",
      "type": "send-message",
      "transitions": [],
      "properties": {
        "offset": {
          "x": 7200,
          "y": 2250
        },
        "body": "That's it! Thanks so much for taking the time to complete this survey and for attending.",
        "to": "{{contact.channel.address}}",
        "from": "{{flow.channel.address}}"
      }
    }
  ],
  "initial_state": "Trigger"
}
