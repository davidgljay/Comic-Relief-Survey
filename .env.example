# Reference only — `npm run deploy` generates .env interactively and doesn't read
# this file. Copy it manually only if you're deploying without that script.
# .env is gitignored — never commit real values.

# --- Twilio (from Comic Relief's Twilio console) ---
# The credential here needs FULL account access: used to run `twilio-run
# deploy` (Serverless Service/Functions/Assets/Environment/Build/Deployment),
# to create/update the Studio Flow, and to attach it to the phone number's
# webhook. Twilio has no Restricted API Key grant covering all of that, so
# there's no narrower scope available — see scripts/deploy.js for more detail.
ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Leave API_KEY_SID blank if your account still shows a plain Auth Token
# (most do) and put that token below. If Twilio only offers API keys, create
# a Standard one (Account > API keys & tokens > Create API key) and put its
# SID here instead — then put its Secret, not an Auth Token, below.
API_KEY_SID=
AUTH_TOKEN=your_twilio_auth_token_or_api_key_secret
STUDIO_FLOW_SID=FWXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+15551234567

# --- Google Sheets (create both blank, `npm run deploy` inserts the header row) ---
CONTACTS_SHEET_ID=id_segment_of_the_contacts_and_results_sheet_url
ANONYMOUS_SHEET_ID=id_segment_of_the_anonymous_results_sheet_url

# --- Google Apps Script Web App (see apps-script/Code.gs) that owns both Sheets ---
# The /exec URL from Deploy > New deployment > Web app in the Apps Script editor.
# Its CONFIG must be set to the same two Sheet IDs above, plus SHARED_SECRET below.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec
# Auto-generated by `npm run deploy` if left unset — must match the SHARED_SECRET
# constant set at the top of apps-script/Code.gs.
APPS_SCRIPT_SECRET=choose_a_long_random_string

# --- Shared secret required by the external cron job to call /trigger-send ---
# Auto-generated by `npm run deploy` if left unset.
TRIGGER_SEND_SECRET=choose_a_long_random_string
