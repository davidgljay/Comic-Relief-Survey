# Reference only — `npm run deploy` generates .env interactively and doesn't read
# this file. Copy it manually only if you're deploying without that script.
# .env is gitignored — never commit real values.

# --- Twilio (from Comic Relief's Twilio console) ---
ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AUTH_TOKEN=your_twilio_auth_token
STUDIO_FLOW_SID=FWXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+15551234567

# --- Contact/results Google Sheet (holds name + phone) ---
CONTACTS_SHEET_ID=google_sheet_id_for_contacts_and_full_results
# --- Anonymous results Google Sheet (answers only, no PII) ---
ANONYMOUS_SHEET_ID=google_sheet_id_for_anonymous_results

# --- Google service account (created + owned by Comic Relief) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=survey-bot@some-project.iam.gserviceaccount.com
# Paste the full private key, keeping \n escapes, wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Shared secret required by the external cron job to call /trigger-send ---
TRIGGER_SEND_SECRET=choose_a_long_random_string
